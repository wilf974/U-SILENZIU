# Variables d'environnement pour PRODUCTION
# Copiez ce fichier vers .env.prod et modifiez les valeurs

# Environnement
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Secrets de production (GÉNÉRÉS ALÉATOIREMENT - CHANGEZ-LES !)
SESSION_SECRET=CHANGE_ME_PRODUCTION_SESSION_SECRET_32_CHARS_MIN
JWT_SECRET=CHANGE_ME_PRODUCTION_JWT_SECRET_32_CHARS_MIN
JWT_EXPIRES_IN=1h

# Base de données PostgreSQL PRODUCTION
DATABASE_URL=postgresql://usilenzio_user:CHANGE_ME_POSTGRES_PASSWORD@localhost:5432/usilenzio
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=usilenzio
POSTGRES_USER=usilenzio_user
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# Redis PRODUCTION
REDIS_URL=redis://localhost:6379

# URL et domaine de production
NEXT_PUBLIC_URL=https://votre-domaine.com
DOMAIN=votre-domaine.com

# Configuration SMTP de production
SMTP_HOST=smtp.votre-provider.com
SMTP_PORT=587
SMTP_USER=votre-email@votre-domaine.com
SMTP_PASSWORD=VOTRE_MOT_DE_PASSE_EMAIL
SMTP_FROM=contact@votre-domaine.com

# Sécurité production
ALLOWED_ORIGINS=https://votre-domaine.com,https://www.votre-domaine.com
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=900000

# Monitoring (optionnel)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# API Keys (si nécessaires)
# STRIPE_SECRET_KEY=sk_live_...
# GOOGLE_ANALYTICS_ID=GA-...

# Configuration SSL (si géré par l'application)
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/private.key
