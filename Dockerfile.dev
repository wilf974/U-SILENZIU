# Dockerfile pour DÉVELOPPEMENT
# Multi-stage build optimisé pour le développement avec hot reload

# Stage de base
FROM node:18-alpine AS base
RUN apk add --no-cache libc6-compat
WORKDIR /app

# Installer les dépendances
COPY package.json package-lock.json ./
RUN npm ci

# Stage de développement
FROM base AS development
WORKDIR /app

# Installer nodemon pour le hot reload
RUN npm install -g nodemon

# Copier le code source
COPY . .

# Créer les répertoires nécessaires
RUN mkdir -p public/uploads logs data && \
    chown -R node:node /app

# Exposer les ports
EXPOSE 3000 9229

# Utilisateur non-root pour la sécurité
USER node

# Commande par défaut (peut être surchargée)
CMD ["npm", "run", "dev"]