# Variables d'environnement pour DÉVELOPPEMENT
# Copiez ce fichier vers .env.dev et modifiez les valeurs

# Environnement
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1

# Secrets de développement (changez ces valeurs !)
SESSION_SECRET=dev_session_secret_change_me_12345
JWT_SECRET=dev_jwt_secret_change_me_67890
JWT_EXPIRES_IN=24h

# Base de données PostgreSQL DEV
DATABASE_URL=postgresql://usilenzio_user:usilenzio_dev_password_2024@localhost:5432/usilenzio_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=usilenzio_dev
POSTGRES_USER=usilenzio_user
POSTGRES_PASSWORD=usilenzio_dev_password_2024

# Redis DEV
REDIS_URL=redis://localhost:6379

# URL de l'application
NEXT_PUBLIC_URL=http://localhost:3000
DOMAIN=localhost

# Configuration SMTP pour les tests (optionnel en dev)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_mailtrap_user
SMTP_PASSWORD=your_mailtrap_password
SMTP_FROM=dev@usilenziu.com

# Options de développement
NEXT_DEV=true
FAST_REFRESH=true
DEBUG=true
