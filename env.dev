# Configuration pour l'environnement de développement
# U Silenziu - Janvier 2025

# Environnement
NODE_ENV=development
DEBUG=true
LOG_LEVEL=debug

# Base de données PostgreSQL
DATABASE_URL=postgresql://usilenzio_user:usilenzio_password_dev@localhost:5432/usilenzio_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=usilenzio_dev
POSTGRES_USER=usilenzio_user
POSTGRES_PASSWORD=usilenzio_password_dev

# Secrets applicatifs (développement)
SESSION_SECRET=dev_session_secret_change_me_in_production
JWT_SECRET=dev_jwt_secret_change_me_in_production
JWT_EXPIRES_IN=24h

# Redis (optionnel en développement)
REDIS_URL=redis://localhost:6379

# Configuration Next.js
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Configuration SMTP (développement)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@usilenziu.local

# Configuration des uploads
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,image/webp

# Configuration de l'application
APP_NAME=U Silenziu
APP_VERSION=1.0.0
APP_DESCRIPTION=Zone de défoulement à Buros

# URLs de contact
CONTACT_EMAIL=info@usilenziu.com
CONTACT_PHONE=+33 7 83 83 64 53
CONTACT_ADDRESS=Buros, France

# Horaires d'ouverture
OPENING_HOURS="Mardi-Jeudi: 14h-21h | Vendredi-Samedi: 14h-00h"

# Configuration des réseaux sociaux
FACEBOOK_URL=
INSTAGRAM_URL=
TWITTER_URL=
