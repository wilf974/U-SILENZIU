# Configuration pour l'environnement de production
# U Silenziu - Janvier 2025
# ⚠️  IMPORTANT: Changez tous les secrets en production !

# Environnement
NODE_ENV=production
DEBUG=false
LOG_LEVEL=info

# Base de données PostgreSQL
DATABASE_URL=postgresql://usilenzio_user:usilenzio_password_2024@postgres:5432/usilenzio
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=usilenzio
POSTGRES_USER=usilenzio_user
POSTGRES_PASSWORD=usilenzio_password_2024

# Secrets applicatifs (PRODUCTION - À CHANGER !)
SESSION_SECRET=CHANGE_ME_SESSION_SECRET_PRODUCTION_2025
JWT_SECRET=CHANGE_ME_JWT_SECRET_PRODUCTION_2025
JWT_EXPIRES_IN=1h

# Redis
REDIS_URL=redis://redis:6379

# Configuration Next.js
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_APP_URL=https://usilenziu.com

# Configuration SMTP (production)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info@usilenziu.com
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM=noreply@usilenziu.com

# Configuration des uploads
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,image/webp

# Configuration de l'application
APP_NAME=U Silenziu
APP_VERSION=1.0.0
APP_DESCRIPTION=Zone de défoulement à Buros

# URLs de contact
CONTACT_EMAIL=info@usilenziu.com
CONTACT_PHONE=+33 7 83 83 64 53
CONTACT_ADDRESS=Buros, France

# Horaires d'ouverture
OPENING_HOURS="Mardi-Jeudi: 14h-21h | Vendredi-Samedi: 14h-00h"

# Configuration des réseaux sociaux
FACEBOOK_URL=
INSTAGRAM_URL=
TWITTER_URL=

# Configuration SSL/HTTPS
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# Configuration de sauvegarde
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE="0 2 * * *"

# Configuration de monitoring
ENABLE_MONITORING=true
LOG_FILE_PATH=/app/logs/app.log
